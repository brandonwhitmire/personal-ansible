# ASCII line break of '=' chars by default or $1 arg supplied
BREAKLINE () {
        if [[ -z "$1" ]] ; then
                CHAR="="
        else
                CHAR="$1"
        fi

        printf "$CHAR%.0s" {1..80} ; echo
}
# Download magnets
download () {
	# NOTE: This IP address is known to change
	MAGNET_VPN="209.58.135.120"

	# Keep .zhistory clean of downloads
	unset HISTFILE
	echo "HISTFILE (should be blank b/t quotes): \"$HISTFILE\""
	
	# Clean previous history from commands in case of error
	CLEANS=(
		".*download .*"
		".*magnet:\?.*"
		".*\?xt.*"
		".*transmission.*"
		"^\s*$"
	)
	for CLEAN in $CLEANS ; do
		sed -i "s#$CLEAN##g" ~/.zhistory
	done

	# Requires magnet link (MUST be quoted!)
	if [[ -z "$1" ]] ; then
		echo "Please supply magnet"
		exit 1
	fi

	# Naive check to make sure on desired VPN	
	if [[ $(hazip) == "$MAGNET_VPN" ]] ; then
		echo "Already on proper VPN..."
	else
		echo "STARTING proper VPN..."
		~/scripts/openvpn_configs/1_run_openvpn.sh ~/scripts/openvpn_configs/ca1.ovpn
	fi

	# Start transmission-daemon server if not running
	if ! pgrep "transmission-da*" ; then
		# Download and update blocklists
		BLOCKS=(
			"https://github.com/sahsu/transmission-blocklist/releases/latest/download/blocklist.gz"
			"https://github.com/Naunter/BT_BlockLists/raw/master/bt_blocklists.gz"
		)
		pushd ~/.config/transmission-daemon/blocklists > /dev/null
			"rm" -vf *blocklist*
			for BLOCK in $BLOCKS ; do
				wget --no-verbose "$BLOCK"	
			done
			gunzip -d *.gz
			for FILE in *blocklist* ; do
				mv $FILE $FILE.bin
			done
		popd > /dev/null 2>&1

		echo "Starting transmission-daemon..."
		transmission-daemon
		sleep 4
		echo "Updating blocklists..."
		transmission-remote --blocklist-update
	else
		echo "transmission-daemon already running..."
	fi

	# Add and watch downloads
	MAGNET=$(python3 -c "import urllib.parse;print(urllib.parse.unquote_plus('$1', encoding='utf-8'))" | grep -o "magnet.*")
	echo -e "MAGNET:\t$MAGNET"
	transmission-remote -a "$MAGNET"
	sleep 1
	watch -d -n 2 'transmission-remote -l'
	echo -e "\nREMOVE TORRENTS:\n\n\ttransmission-remote -tall --remove"	
}
