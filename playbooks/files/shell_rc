# Mount LUKS device
# $1: UUID of harddrive (obtain via "sudo fdisk -l")
# $2: name to crypt open as
mount_luks_device () {
	# Help menu
	if [[ "$1" == "-h" ]] ; then
		echo -e "Usage:\t$0 UUID crypt_device_name"
		echo -e "\t$0 \"58ea1ec5-1654-4d85-92bd-e093f0a1439b\" crypt_harddrive"
		return 100
	fi

	# Use preloaded variables
	if [[ -z "$1" || -z "$2" ]] ; then
		UUID="eb3382b7-477b-4e93-a103-e4269ec5d0b3"
		NAME="crypt_hdd"
		echo "CLI arguments not used..."
		echo -e "\tUUID: $UUID"
		echo -e "\tNAME: $NAME"
	# Use CLI arguments
	else
		UUID="$1"
		NAME="$2"
	fi
	# ---
	DEVICE=$(lsblk --raw --output NAME,UUID | grep "$UUID" | cut --delimiter ' ' --fields 1 )

	if [[ -z "$UUID" || -z "$DEVICE" || -z "$NAME" ]] ; then
		echo "These cannot be empty!"
		echo -e "\tUUID: $UUID"
		echo -e "\tDEVICE: $DEVICE"
		echo -e "\tNAME: $NAME"
		return 1
	fi

	# Check if LUKS device mounted
	udisksctl info --block-device /dev/mapper/"$NAME" > /dev/null 2>&1
	RET_CODE="$?"

	# Device not mounted ; so mount
	if [[ "$RET_CODE" == "1" ]] ; then
		echo "MOUNTING..."
		sudo cryptsetup open "/dev/$DEVICE" "$NAME"
		MOUNT=$(udisksctl mount --block-device /dev/mapper/"$NAME")
		echo "$MOUNT"
		ll $(echo "$MOUNT" | awk -F ' ' '{print $NF}')
	# Device already mounted ; so unmount
	elif [[ "$RET_CODE" == "0" ]] ; then
		echo "UNMOUNTING..."
		udisksctl unmount --block-device /dev/mapper/"$NAME"
		sudo cryptsetup close "$NAME"
	# Error
	else
		echo "CRITICAL ERROR!"
		echo "Return code: $RET_CODE"
		return 2
	fi
}
# Encrypted, de-duplicated, & compressed backups
borg_backup () {
	REPO_BORG="/run/media/obb/nix_hdd/borg_backup"
	TODAY="$(date +%Y-%m-%d)"

	# Create/intialize backup
	# sudo borg --verbose init --encryption=repokey-blake2 "$REPO_BORG"

	# borg program ENVs
	export BORG_RELOCATED_REPO_ACCESS_IS_OK=no
	export BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=no

	# ---

	# Ensure repo directory is there exists
	if [[ ! -d "$REPO_BORG" ]] ; then
		echo "ERROR finding the repo: >>$REPO_BORG<<"
		return 1
	fi

    # Useful for manual backups or new name (to backup more than once/day)
	if [[ -z "$1" ]] ; then
		EXTRA_TAG="auto"
	else
		EXTRA_TAG="$1"
	fi

	# ---

	borg --version
    BREAKLINE
	echo $TODAY
    BREAKLINE

    # NOTE: sudo required for reading "/etc"
	sudo borg \
        create \
        --progress \
        --stats \
        --compression auto,lzma \
        --comment "Autobackup: $TODAY" \
        --exclude '*.img' \
        --exclude '*.iso' \
        --exclude '*.ova' \
        --exclude '*.vdi' \
        --exclude '*.vmdk' \
        --exclude $HOME/.local \
        --exclude $HOME/.cache \
        --exclude $HOME/.vagrant.d \
        --exclude $HOME/.wine \
        --exclude $HOME/.yarn \
        --exclude $HOME/.npm \
        --exclude $HOME/.gem \
        --exclude $HOME/.config/chromium \
        $REPO_BORG::${TODAY}_${EXTRA_TAG} \
        /etc \
        $HOME

	# Finish buffering anything from memory to disk
	sync
}
update_no_backup () {
