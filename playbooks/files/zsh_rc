# Update pacman mirrors
# Reference: https://xyne.dev/projects/reflector/
: "${ARCH_MIRROR_COUNTRY:=US}"
update_mirrors () {
    echo "[i] Updating package mirrors..."
    sudo reflector \
        --country "${ARCH_MIRROR_COUNTRY}" \
        --ipv4 \
        --latest 10 \
        --completion-percent 100 \
        --protocol https \
        --sort rate \
        --threads 5 \
        --save /etc/pacman.d/mirrorlist
    echo -e "\n[i] Every run of pacman-mirrors requires you to syncronize your database and update your system\n"
    sudo pacman -S --refresh --sysupgrade
}
