# Burn ISO 9660 files (liveboots) to devices
# TODO: add more safety checks and confirm device before write
iso_burn () {
    LIVEBOOT_ISO="${1}"
    TARGET_DEVICE="${2}"

    if [[ ! -e "$LIVEBOOT_ISO" ]] ; then
        echo "Liveboot ISO (9660) file does not exist!: $1"
        exit 1
    fi

    echo "Pausing for dramatic effect..."
    sleep 7

    dd \
        bs=32M \
        conv=fsync \
        oflag=direct \
        status=progress
        if="${1}" \
        of="${2}"
}

