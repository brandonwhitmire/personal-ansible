general {
        colors = true
        interval = 5
}

order += "wireless _first_"
wireless "_first_" {
        format_up = " 📶 %essid %ip (%quality)"
        format_down = "❌ W: down"
}

order += "ethernet _first_"
ethernet "_first_" {
        format_up = " 🌐 %ip (%speed)"
        format_down = "❌ E: down"
}

order += "disk /"
disk "/" {
        format = " 💾 %avail GB"
}

order += "battery all"
battery all {
        format = "%status %percentage %remaining"
        format_down = "🔌 No battery"
        status_chr = "⚡ CHR"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        low_threshold = 25
}

order += "cpu_usage"
cpu_usage {
        format = " 🖥️ %usage"
}

order += "memory"
memory {
        format = " 🧠 %used/%total"
        threshold_degraded = "1G"
        format_degraded = "⚠️ MEMORY < %available"
}

order += "load"
load {
        format = " ⚖️ %1min%"
}

order += "tztime local"
tztime local {
        format = "🕐 %d-%b %H:%M"
}