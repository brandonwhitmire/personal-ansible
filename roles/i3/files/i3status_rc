general {
        colors = true
        interval = 5
}

order += "wireless _first_"
wireless "_first_" {
        format_up = "📶 %essid %ip%quality"
        format_down = "❌ Wifi"
}

order += "ethernet _first_"
ethernet "_first_" {
        format_up = "🌐 %ip"
        format_down = "❌ Ethernet"
}

order += "disk /"
disk "/" {
        format = "💾 MEM %avail"
}

order += "cpu_usage"
cpu_usage {
        format = "🖥️ CPU %usage"
}

order += "memory"
memory {
        format = "🧠 %used/%total"
        threshold_degraded = "1G"
        format_degraded = "⚠️ MEMORY < %available"
}

order += "battery all"
battery all {
        format = "%status %percentage %remaining"
        format_down = "🔌 No battery"
        status_chr = "⚡ CHR"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        low_threshold = 25
}

order += "tztime local"
tztime local {
        format = "🕐 %d-%b %H:%M"
}