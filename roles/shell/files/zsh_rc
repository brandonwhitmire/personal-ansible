# Install packages properly
install () {
	if [[ -z "$1" ]] ; then
		echo "Please supply a package(s) to INSTALL!"
		exit 1
	fi
	echo -e "[i] Trying official repos"
    sudo pacman -S "$@" ||
        echo -e "[E] Official repos failed\n\n[i] Trying AUR" &&
        yay -S "$@"
}
# Removes packages and dependencies (not used by other packages)
uninstall () {
    if [[ -z "$1" ]] ; then
        echo "Please supply a package(s) to UNINSTALL!"
        exit 1
    fi
	sudo pacman -R --recursive --unneeded "$@"
}
