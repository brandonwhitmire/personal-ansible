# === Command Execution Timing ===
# Display command execution time similar to VSCode shell output
# Shows: user time, system time, CPU percentage, total time, and start timestamp

# Initialize timing variables
zsh_command_start_time=""
zsh_command_start_timestamp=""
zsh_command_start_utime=""
zsh_command_start_stime=""

# Hook to capture command start time and CPU stats
preexec() {
    zsh_command_start_time=$SECONDS
    zsh_command_start_timestamp=$(date '+%H:%M:%S')
    # Get initial CPU time from /proc/self/stat (field 14 = utime, field 15 = stime, in clock ticks)
    if [[ -r /proc/self/stat ]]; then
        local stat_line=($(cat /proc/self/stat))
        zsh_command_start_utime=${stat_line[13]}  # utime (index 13, 0-based)
        zsh_command_start_stime=${stat_line[14]}  # stime (index 14, 0-based)
    else
        zsh_command_start_utime=0
        zsh_command_start_stime=0
    fi
}

# Hook to display command execution time after command completes
precmd() {
    if [[ -n "$zsh_command_start_time" ]]; then
        local end_time=$SECONDS
        local end_timestamp=$(date '+%H:%M:%S')
        local elapsed=$(($end_time - $zsh_command_start_time))
        
        if (( elapsed > 0.1 )); then  # Only show for commands taking more than 0.1 seconds
            # Get final CPU time
            local end_utime=0
            local end_stime=0
            if [[ -r /proc/self/stat ]]; then
                local stat_line=($(cat /proc/self/stat))
                end_utime=${stat_line[13]}  # utime
                end_stime=${stat_line[14]}  # stime
            fi
            
            # Calculate CPU time used (in clock ticks, convert to seconds)
            # Clock ticks per second is typically 100 (getconf CLK_TCK)
            local clk_tck=$(getconf CLK_TCK 2>/dev/null || echo 100)
            local cpu_user_diff=$((end_utime - zsh_command_start_utime))
            local cpu_system_diff=$((end_stime - zsh_command_start_stime))
            
            local user_time=$(echo "scale=2; $cpu_user_diff / $clk_tck" | bc 2>/dev/null || echo "0.00")
            local system_time=$(echo "scale=2; $cpu_system_diff / $clk_tck" | bc 2>/dev/null || echo "0.00")
            
            # Calculate CPU percentage
            local cpu_percent="0.0"
            if (( $(echo "$elapsed > 0" | bc -l 2>/dev/null || echo 0) )); then
                local cpu_total=$(echo "scale=2; $user_time + $system_time" | bc 2>/dev/null || echo "0.00")
                cpu_percent=$(echo "scale=1; ($cpu_total / $elapsed) * 100" | bc 2>/dev/null || echo "0.0")
            fi
            
            # Format times to match VSCode output format
            local user_time_str=$(printf "%.2fs" $user_time 2>/dev/null || echo "0.00s")
            local system_time_str=$(printf "%.2fs" $system_time 2>/dev/null || echo "0.00s")
            local total_time_str=$(printf "%.2fs" $elapsed 2>/dev/null || echo "0.00s")
            
            # Display in VSCode-like format: "start_timestamp end_timestamp user_time system_time CPU% total_time"
            printf "\033[2m%s %s %s user %s system %s%% cpu %s total\033[0m\n" \
                "$zsh_command_start_timestamp" \
                "$end_timestamp" \
                "$user_time_str" \
                "$system_time_str" \
                "$cpu_percent" \
                "$total_time_str"
        fi
        
        # Reset for next command
        zsh_command_start_time=""
        zsh_command_start_utime=""
        zsh_command_start_stime=""
    fi
}

# === AUTOSTART XORG ===
# https://wiki.archlinux.org/title/Xinit#Autostart_X_at_login
# This must come before zellij because it uses exec, which replaces the shell process
[[ -z $DISPLAY && $XDG_VTNR -eq 1 ]] && exec startx

# === AUTOSTART ZELLIJ ===
# Auto-start zellij terminal multiplexer for interactive shells or SSH sessions
# Only start if not already in zellij (ZELLIJ env var not set)
if [[ ( -o interactive || -n "$SSH_CONNECTION" ) && -z "$ZELLIJ" ]]; then
    exec zellij
fi
