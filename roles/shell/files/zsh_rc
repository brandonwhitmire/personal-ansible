# Set/Fix monitor displays
# For extended displays, run like: "set_displays"
# For duplicated displays, run like: "set_displays asdfasdf"
set_displays () {
	echo "FIX: Hit button on external monitor to pop info box (wake monitor) or reset KVM switch..."
	
	DISPLAYS="$(xrandr | grep -E '[^dis]connected' | awk '{ print $1 }')"
	LAPTOP_KEYWORD='eDP-?[0-9\-]+'
	LAPTOP_MONITOR="$(echo $DISPLAYS | grep -ioE $LAPTOP_KEYWORD)"
	EXTERNAL_KEYWORD='HDMI-?[0-9\-]+'
	EXTERNAL_MONITOR="$(echo $DISPLAYS | grep -ioE $EXTERNAL_KEYWORD)"

	# Give no options to activate this mode
	if [[ -z "$1" ]] ; then
		echo "[+] Setting EXTENDED Display mode!"
		xrandr --output "$EXTERNAL_MONITOR" --primary --mode 1920x1080 --pos 0x0 --rotate normal \
			--output "$LAPTOP_MONITOR" --mode 1920x1080 --pos 1920x0 --rotate normal
	# Give any arbitrary option to activate this mode
	else
		echo "[+] Setting DUPLICATED Display mode!"
		xrandr --output "$LAPTOP_MONITOR" --mode 1920x1080 --pos 0x0 --rotate normal \
			--output "$EXTERNAL_MONITOR" --mode 1920x1080 --pos 0x0 --rotate normal
	fi
}

