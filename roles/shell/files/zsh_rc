# Helper: Get list of connected displays
_get_connected_displays () {
	xrandr | grep -E '[^dis]connected' | awk '{ print $1 }'
}

# Helper: Detect laptop display (eDP-*)
_detect_laptop_display () {
	local displays="$(_get_connected_displays)"
	echo "$displays" | grep -ioE 'eDP-?[0-9\-]+' | head -n1
}

# Helper: Detect external display (HDMI-* or DP-*, prefers HDMI)
_detect_external_display () {
	local displays="$(_get_connected_displays)"
	local hdmi=$(echo "$displays" | grep -ioE 'HDMI-?[0-9\-]+' | head -n1)
	local dp=$(echo "$displays" | grep -ioE 'DP-?[0-9\-]+' | head -n1)
	
	if [[ -n "$hdmi" ]]; then
		echo "$hdmi"
	else
		echo "$dp"
	fi
}

# Helper: Get native/preferred resolution for a display
_get_display_resolution () {
	local display="$1"
	if [[ -z "$display" ]]; then
		return 1
	fi
	
	# Get the native resolution (marked with *+) for this specific display
	xrandr --query | \
		awk -v display="$display" '
			$0 ~ "^" display " connected" { found=1; next }
			found && /\*\+/ { print $1; exit }
			found && /^[A-Z]/ { exit }
		'
}

# Auto-configure displays: set all connected displays to their native resolution
# External monitor is positioned on the left, laptop on the right
display_auto () {
	local displays="$(_get_connected_displays)"
	
	if [[ -z "$displays" ]]; then
		echo "ERROR: No connected displays found"
		return 1
	fi
	
	# Detect external and laptop displays
	local external="$(_detect_external_display)"
	local laptop="$(_detect_laptop_display)"
	
	local pos_x=0
	
	# Configure both displays in a single xrandr command for proper linking
	# This ensures mouse can move seamlessly in both directions
	if [[ -n "$external" ]] && [[ -n "$laptop" ]]; then
		local external_res="$(_get_display_resolution "$external")"
		local laptop_res="$(_get_display_resolution "$laptop")"
		
		if [[ -n "$external_res" ]] && [[ -n "$laptop_res" ]]; then
			local external_width=$(echo "$external_res" | cut -d'x' -f1)
			local laptop_pos=$external_width
			
			echo "[+] Configuring dual display setup:"
			echo "    External (left, primary): $external - $external_res"
			echo "    Laptop (right): $laptop - $laptop_res at position ${laptop_pos}x0"
			
			# Configure both displays in ONE command for proper adjacency
			xrandr --output "$external" --primary --mode "$external_res" --pos "${pos_x}x0" --rotate normal \
			       --output "$laptop" --mode "$laptop_res" --pos "${laptop_pos}x0" --rotate normal
		fi
	elif [[ -n "$external" ]]; then
		# Only external monitor
		local external_res="$(_get_display_resolution "$external")"
		
		if [[ -n "$external_res" ]]; then
			echo "[+] Configuring external monitor (primary): $external - $external_res"
			xrandr --output "$external" --primary --mode "$external_res" --pos "${pos_x}x0" --rotate normal
		fi
	elif [[ -n "$laptop" ]]; then
		# Only laptop display
		local laptop_res="$(_get_display_resolution "$laptop")"
		
		if [[ -n "$laptop_res" ]]; then
			echo "[+] Configuring laptop display (primary): $laptop - $laptop_res"
			xrandr --output "$laptop" --primary --mode "$laptop_res" --pos "${pos_x}x0" --rotate normal
		fi
	else
		# If no external/laptop detected, fall back to configuring all displays in order
		local first_display=true
		pos_x=0
		
		for display in $displays; do
			local native_res="$(_get_display_resolution "$display")"
			
			if [[ -z "$native_res" ]]; then
				echo "WARNING: Could not detect native resolution for $display, skipping"
				continue
			fi
			
			echo "[+] Configuring $display: $native_res"
			
			if [[ "$first_display" == true ]]; then
				xrandr --output "$display" --primary --mode "$native_res" --pos "${pos_x}x0" --rotate normal
				first_display=false
			else
				xrandr --output "$display" --mode "$native_res" --pos "${pos_x}x0" --rotate normal
			fi
			
			local width=$(echo "$native_res" | cut -d'x' -f1)
			pos_x=$((pos_x + width))
		done
	fi
}

